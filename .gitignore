node_modules/
.cursor
Games/**/.git-embedded/
.env

# Build output — regenerated by `npm run build:all` / `npm run build:pages`,
# and by the Pages workflow on every push to main.
dist/

# Transient output of each game's `npm run check:logic` (compiled game logic
# plus the self-check runner). Regenerated on every run. `.balance/` is the
# same thing for Pick-Red's `npm run balance`.
.self-check/
.balance/
# Ad-hoc measurement runners get their own outDir so they never collide with a
# balance run in progress; same throwaway status as the two above.
.ct/
.sweep/
.pp/
.isweep/

Games/.DS_Store
.DS_Store

# Single lockfile at repo root (npm workspaces). Do not reintroduce per-game locks.
Games/*/package-lock.json
