{
  "name": "@clubhouse/shared",
  "private": true,
  "version": "0.1.0",
  "description": "Shared UI chrome and utilities for Clubhouse Games",
  "type": "module",
  "exports": {
    "./BackToMenu": "./BackToMenu.tsx",
    "./ResultOverlay": "./ResultOverlay.tsx",
    "./ScoreFlash": "./ScoreFlash.tsx",
    "./TouchButton": "./TouchButton.tsx",
    "./synthAudio": "./synthAudio.ts",
    "./shuffle": "./shuffle.ts",
    "./vite-alias": "./vite-alias.mjs",
    "./tailwind-content": "./tailwind-content.mjs",
    "./tailwind-source.css": "./tailwind-source.css",
    "./tsconfig.paths.json": "./tsconfig.paths.json",
    "./package.json": "./package.json"
  },
  "files": [
    "*.tsx",
    "*.ts",
    "*.mjs",
    "*.css",
    "tsconfig.paths.json"
  ],
  "peerDependencies": {
